# Copy to .env.local and fill in the real values from your Supabase dashboard
# (Project Settings > API). .env.local is git-ignored; this template is not, so
# never put real credentials in THIS file.
#
# These same two names must exist as GitHub Actions repository secrets
# (Settings > Secrets and variables > Actions) — the Pages build reads them
# there. Next.js inlines NEXT_PUBLIC_* at BUILD time, so a build that can't see
# them ships a bundle where every Supabase call fails at runtime.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only set for the GitHub Pages build, where the site is served from a subpath
# (…github.io/Nemos-Study/). Leave unset for local dev and Vercel, both of which
# serve from the domain root. CI sets this in .github/workflows/nextjs.yml.
# NEXT_PUBLIC_BASE_PATH=/Nemos-Study
